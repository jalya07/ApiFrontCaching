<!DOCTYPE html>
<html>
<head>
    <title>Products</title>
</head>
<body>

<button onclick="loadProducts()">
    Get Products
</button>

<div id="products"></div>

<script>

async function loadProducts() {

    const response =
        await fetch("https://localhost:5065/api/products");

    const products =
        await response.json();

    console.log(products); // можно оставить для проверки

    let html = "";

    products.forEach(product => {
        html += `<p>${product.name}</p>`;
    });

    document.getElementById("products").innerHTML = html;
}

</script>

</body>
</html>
